# === Bắt buộc ===
GEMINI_API_KEY=your_gemini_api_key_here

# === Discord (cần khi chạy bot) ===
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=

# Kênh kiến thức bot được phép đọc (phân cách bằng dấu phẩy)
KNOWLEDGE_CHANNEL_IDS=

# Tag người hỗ trợ khi bot không chắc (ưu tiên USER hơn ROLE)
# Chuột phải avatar Admin (NeTi) → Copy User ID
MENTOR_USER_ID=
# (Tuỳ chọn) role mentor — để trống nếu chỉ muốn tag 1 người
MENTOR_ROLE_ID=

# (Tuỳ chọn) chỉ lắng nghe hỏi trong 1 kênh; để trống = mọi kênh bot thấy
ASK_CHANNEL_ID=

# === Model / RAG ===
GEMINI_MODEL=gemini-3.1-flash-lite
SIMILARITY_THRESHOLD=0.12
TOP_K=4
PENDING_TIMEOUT_HOURS=6
