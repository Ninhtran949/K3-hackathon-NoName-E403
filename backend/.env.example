# Application
APP_ENV=development
LOG_LEVEL=INFO

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MONITORED_CHANNEL_IDS=
DISCORD_SUPPORT_CHANNEL_ID=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
MENTOR_RESEARCH_MODEL=gemini-2.5-flash

# Embedding
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=student_assistant_knowledge

# Externalized configuration and prompts
APP_CONFIG_PATH=./configs/app.yaml
ROUTING_CONFIG_PATH=./configs/routing.yaml
ONBOARDING_CONFIG_PATH=./configs/onboarding.yaml
ONBOARDING_STATE_DB_PATH=./data/state/onboarding.sqlite3
SUPPORT_STATE_DB_PATH=./data/state/support.sqlite3
SYSTEM_PROMPT_PATH=./prompts/rag_answer.md
MENTOR_DRAFT_PROMPT_PATH=./prompts/mentor_draft.md
SEED_DATA_DIR=./data/seed
SEED_ON_STARTUP=true
