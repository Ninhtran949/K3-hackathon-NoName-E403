# Copy file này thành .env rồi điền token lấy từ Discord Developer Portal.
# Code hỗ trợ cả DISCORD_TOKEN (tương thích v1) và DISCORD_BOT_TOKEN (tên trong spec).
DISCORD_TOKEN=your_discord_bot_token_here

# ID server dùng để đồng bộ slash command nhanh khi phát triển.
# Để trống nếu muốn dùng global commands.
DISCORD_GUILD_ID=

# P0 Build Phase: chỉ các channel trong allowlist mới được đọc/lưu.
# Nhiều ID được ngăn cách bằng dấu phẩy.
DISCORD_QA_CHANNEL_IDS=
DISCORD_ANNOUNCEMENT_CHANNEL_IDS=
DISCORD_SUPPORT_CHANNEL_ID=

# Role được xem là nguồn chính thức và được phép xử lý support ticket.
DISCORD_ADMIN_ROLE_IDS=
DISCORD_MENTOR_ROLE_IDS=
DISCORD_DEFAULT_SUPPORT_ROLE_ID=

# Bắt buộc cho ingest nội dung message/mention.
# Đồng thời phải bật Message Content Intent trong Developer Portal.
ENABLE_MESSAGE_CONTENT_INTENT=false

# Tùy chọn: ID kênh gửi lời chào thành viên mới.
WELCOME_CHANNEL_ID=

# Chỉ bật khi dùng tính năng chào thành viên mới.
# Đồng thời phải bật Server Members Intent trong Discord Developer Portal.
ENABLE_MEMBER_INTENT=false

# AI. Nếu chưa có key, bot không đoán; câu hỏi sẽ được route cho con người.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Retrieval P0 dùng SQLite lexical search; Chroma/vector được để sang phase sau.
ROUTING_CONFIG_PATH=config/routing.json
TOP_K=5
SIMILARITY_THRESHOLD=0.55
SOURCE_RETENTION_DAYS=30
SUPPORT_CASE_RETENTION_DAYS=90
MAX_REINDEX_MESSAGES=200

# true tránh làm lộ câu trả lời lấy từ channel khác cho cả channel hiện tại.
ASK_EPHEMERAL=true

DATABASE_PATH=data/bot.db
LOG_DIR=logs
LOG_LEVEL=INFO
MAX_NOTES_PER_USER=50
